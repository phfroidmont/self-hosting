          "expr": "topk(10, sum by (unit) (label_replace(count_over_time({host=~\"$host\", unit=~\"$unit\"} |~ \"(?i)$search\" [$__auto]), \"unit\", \"nginx $1\", \"filename\", \"/var/log/nginx/(.*)\")))",
